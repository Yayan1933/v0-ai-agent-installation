# Token bot Telegram - dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# ===== PILIH SALAH SATU OPSI AI =====

# OPSI 1: Vercel AI Gateway (recommended, support multi-provider)
# Dapatkan di https://vercel.com -> Settings -> AI
AI_GATEWAY_API_KEY=

# OPSI 2: OpenAI langsung (bypass Vercel)
# Dapatkan di https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxx

# ===== WHITELIST USER =====
# Daftar Telegram User ID yang boleh pakai bot, pisahkan dengan koma
# Cara dapat ID Anda: chat ke @userinfobot di Telegram
ALLOWED_TELEGRAM_IDS=123456789

# ===== MODE AI (pilih salah satu) =====
# hemat   - Model termurah (google/gemini-2.0-flash) ~$0.10/1M token
# standar - Balance (openai/gpt-4o-mini) ~$0.30/1M token [DEFAULT]
# premium - Terbaik (claude-sonnet-4) ~$9/1M token
# auto    - Otomatis pilih berdasarkan kompleksitas pesan
AI_MODE=standar

# ===== OVERRIDE MODEL (opsional) =====
# Jika di-set, mode di atas diabaikan
# AI_MODEL=anthropic/claude-sonnet-4-20250514
# AI_MODEL=gpt-4o  (untuk OpenAI direct, tanpa prefix)
